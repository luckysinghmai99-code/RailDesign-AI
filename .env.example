# GEMINI_API_KEY: Required for Google Gemini AI API calls (injected by AI Studio Secrets).
GEMINI_API_KEY=

# APP_URL: The runtime URL where this applet is hosted.
APP_URL=

# Optional AI Providers (Server-Side Only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OAuth Credentials (Optional — configures Google & GitHub OAuth sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (Optional PostgreSQL connection; uses embedded SQLite automatically if unset)
DATABASE_URL=

# Cashfree Payments (Server-Side Only)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Optional Deployment Hosting Adapter (Vercel)
VERCEL_TOKEN=

# Optional Admin Bootstrap Passcode
ADMIN_PASSCODE=
